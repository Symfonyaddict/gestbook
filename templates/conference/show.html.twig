{% extends 'base.html.twig' %}

{% block title %}Conference Guestbook - {{ conference }}{% endblock %}

{% block body %}
    <h2 class="text-white">{{ conference }} Conference</h2>

    {% if comments|length > 0 %}
        <div class="text-white">There are {{ comments|length }} comments.</div>

        {% for comment in comments %}
            {% if comment.photofilename %}
                <img src="{{ asset('uploads/photos/' ~ comment.photofilename) }}" style="max-width: 200px" />
            {% endif %}

            <h4 class="text-white">{{ comment.author }}</h4>
            <small class="text-white">
                {{ comment.createdAt|format_datetime('medium', 'short') }}
            </small>

            <p class="text-white">{{ comment.text }}</p>
        {% endfor %}

        {% if previous >= 0 %}
            <a href="{{ path('conference', { slug: conference.slug, offset: previous }) }}">Previous</a>
        {% endif %}
        {% if next < comments|length %}
            <a href="{{ path('conference', { slug: conference.slug, offset: next }) }}">Next</a>
        {% endif %}

    {% else %}
        <div class="text-white">No comments have been posted yet for this conference.</div>
    {% endif %}
{% endblock %}